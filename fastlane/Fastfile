require "tmpdir"

default_platform(:ios)

platform :ios do
  lane :release do |options|
    version   = options[:version]
    build     = options[:build]
    run_url   = ENV["RUN_URL"]
    repo_dir  = ENV["REPO_DIR"] || File.expand_path("..", __dir__)
    build_log = File.join(Dir.tmpdir, "vocaplay_build.log")

    File.delete(build_log) if File.exist?(build_log)

    begin
      increment_version_number(version_number: version)
      increment_build_number(build_number: build)

      if sh("git status --porcelain").strip.empty?
        UI.message("No version changes to commit")
      else
        sh("git commit -am 'Increased app version to #{version}'")
        sh("git push origin HEAD")
      end

      Dir.chdir(repo_dir) do
        gym(
          project: "voca play.xcodeproj",
          scheme: "voca play",
          configuration: "Release",
          clean: true,
          export_method: "app-store",
          output_directory: "build",
          output_name: "VocaPlay",
          log_path: build_log
        )
      end

      pilot(
        api_key: app_store_connect_api_key(
          key_id:      ENV.fetch("ASC_KEY_ID"),
          issuer_id:   ENV.fetch("ASC_ISSUER_ID"),
          key_content: ENV.fetch("ASC_KEY_CONTENT")
        ),
        skip_submission: true
      )

      slack(
        message: "Build uploaded to TestFlight :rocket:",
        success: true,
        payload: {
          "Version" => "#{version} (#{build})",
          "Run"     => run_url
        },
        default_payloads: []
      )

    rescue => e
      error_text =
        if File.exist?(build_log) && !File.zero?(build_log)
          lines = File.readlines(build_log, chomp: true)
          error_lines = lines.select { |line| line.include?(" error:") }
          error_lines.any? ? error_lines.join("\n") : lines.last(20).join("\n")
        else
          e.message
        end

      slack(
        message: "<!channel> Build failed :x:",
        success: false,
        payload: {
          "Version" => "#{version} (#{build})",
          "Run"     => run_url,
          "Error"   => error_text
        },
        default_payloads: []
      )
      raise
    end
  end
end
