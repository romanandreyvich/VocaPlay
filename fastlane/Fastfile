require "tmpdir"

default_platform(:ios)

platform :ios do
  lane :release do |options|
    version   = options[:version]
    build     = options[:build]
    run_url   = ENV["RUN_URL"]
    repo_dir  = ENV["REPO_DIR"] || File.expand_path("..", __dir__)
    build_log = File.join(Dir.tmpdir, "vocaplay_build.log")

    File.delete(build_log) if File.exist?(build_log)

    begin
      increment_version_number(version_number: version)
      increment_build_number(build_number: build)

      if sh("git status --porcelain").strip.empty?
        UI.message("No version changes to commit")
      else
        sh("git commit -am 'Increased app version to #{version}'")
        sh("git push origin HEAD")
      end

      Dir.chdir(repo_dir) do
        sh(%(
          set -o pipefail &&
          xcodebuild \
            -project "voca play.xcodeproj" \
            -scheme "voca play" \
            -sdk iphonesimulator \
            -configuration Debug \
            -destination 'platform=iOS Simulator,name=iPhone 16e' \
            build 2>&1 | tee -a "#{build_log}"
        ))
      end

      slack(
        message: "Build succeeded :rocket:",
        success: true,
        payload: {
          "Version" => "#{version} (#{build})",
          "Run"     => run_url
        },
        default_payloads: []
      )

    rescue => e
      error_text =
        if File.exist?(build_log) && !File.zero?(build_log)
          lines = File.readlines(build_log, chomp: true)
          error_lines = lines.select { |line| line.include?(" error:") }

          if error_lines.any?
            error_lines.join("\n")
          else
            lines.last(40).join("\n")
          end
        else
          e.message
        end

      slack(
        message: "<!channel> Build failed :x:",
        success: false,
        payload: {
          "Version" => "#{version} (#{build})",
          "Run"     => run_url,
          "Error"   => error_text
        },
        default_payloads: []
      )
      raise
    end
  end
end
