require "tmpdir"

default_platform(:ios)

platform :ios do
  lane :release do |options|
    version        = options[:version]
    build          = options[:build]
    run_url        = ENV["RUN_URL"]
    repo_dir       = ENV.fetch("REPO_DIR")
    log_dir        = File.join(Dir.tmpdir, "vocaplay_build_logs")
    project_path   = File.join(repo_dir, "voca play.xcodeproj")
    output_dir     = File.join(repo_dir, "build")

    FileUtils.rm_rf(log_dir)
    FileUtils.mkdir_p(log_dir)

    begin
      increment_version_number(version_number: version)
      increment_build_number(build_number: build)

      if sh("git status --porcelain").strip.empty?
        UI.message("No version changes to commit")
      else
        sh("git commit -am 'Increased app version to #{version}'")
        sh("git push origin HEAD")
      end

      gym(
        project: project_path,
        scheme: "voca play",
        configuration: "Release",
        clean: true,
        export_method: "app-store",
        output_directory: output_dir,
        output_name: "VocaPlay",
        buildlog_path: log_dir
      )

      pilot(
        api_key: app_store_connect_api_key(
          key_id:      ENV.fetch("ASC_KEY_ID"),
          issuer_id:   ENV.fetch("ASC_ISSUER_ID"),
          key_content: ENV.fetch("ASC_KEY_CONTENT")
        ),
        skip_submission: true
      )

      slack(
        message: "Build uploaded to TestFlight :rocket:",
        success: true,
        payload: {
          "Version" => "#{version} (#{build})",
          "Run"     => run_url
        },
        default_payloads: []
      )

    rescue => e
      log_file = Dir[File.join(log_dir, "**", "*.log")].max
      error_text =
        if log_file && File.size?(log_file)
          lines = File.readlines(log_file, chomp: true)
          error_lines = lines.select { |line| line.include?(" error:") }
          error_lines.any? ? error_lines.join("\n") : lines.last(20).join("\n")
        else
          e.message
        end

      slack(
        message: "<!channel> Build failed :x:",
        success: false,
        payload: {
          "Version" => "#{version} (#{build})",
          "Run"     => run_url,
          "Error"   => error_text
        },
        default_payloads: []
      )
      raise
    end
  end
end
